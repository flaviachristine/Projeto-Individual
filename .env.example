# Modelo de configuração. Copie este arquivo para .env.dev (ambiente local)
# e preencha com os seus dados. NUNCA coloque senhas reais neste arquivo.

AMBIENTE_PROCESSO=desenvolvimento

# Configurações de conexão com o banco de dados
DB_HOST=127.0.0.1
DB_DATABASE=stardew_project
DB_USER=root
DB_PASSWORD=suaSenhaAqui
DB_PORT=3306

# Use DB_SSL=true quando o banco estiver hospedado na nuvem (Aiven, Railway, RDS...)
DB_SSL=false

# Configurações do servidor de aplicação (usadas apenas no ambiente local)
APP_PORT=3333
APP_HOST=localhost

# importante: caso sua senha contenha caracteres especiais, insira-a entre 'aspas'
